# Copy to .env and fill in. Never commit .env — it's gitignored at the repo root.

# ─── Database (Neon Postgres — see DEC-015) ──────────────────────────────────
# Neon Console → your project → Connection Details.
# DATABASE_URL: the *pooled* string (host contains "-pooler") — used by the app.
# DIRECT_URL:   the *direct* string (no "-pooler") — used by `prisma migrate`.
DATABASE_URL="postgresql://<user>:<password>@ep-xxxx-pooler.<region>.aws.neon.tech/femi_ifeoma?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@ep-xxxx.<region>.aws.neon.tech/femi_ifeoma?sslmode=require"

PORT=4000

# ─── Capacity (DEC-021) ──────────────────────────────────────────────────────
# There is deliberately NO cap on guests per time slot — the café absorbs
# demand and manages it on the floor. Per-slot counts are still tracked and
# shown on the staff day sheet. Set a positive number here to reinstate a
# hard limit; leave unset for unlimited.
# SLOT_CAPACITY=
#
# Minutes before an unpaid booking is marked `expired`. No longer reserves
# anything — it just stops abandoned checkouts sitting as pending forever.
BOOKING_HOLD_MINUTES=10

# ─── Paystack ────────────────────────────────────────────────────────────────
# Secret key — verifies webhook signatures and server-side transaction lookups.
# Use the sk_test_… key in development.
PAYSTACK_SECRET_KEY=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Leave RESEND_API_KEY empty to disable sending; bookings still confirm fine.
RESEND_API_KEY=
EMAIL_FROM="Fémi & Ifeoma <bookings@femiandifeoma.com>"
# Address that receives a copy of every confirmed booking.
EMAIL_CAFE_COPY="hello@femiandifeoma.com"

# ─── Admin ───────────────────────────────────────────────────────────────────
# Shared secret for the staff endpoints (x-admin-key header). Placeholder until
# real admin auth lands — see Phase 6 in /docs/06-TASKS.md.
ADMIN_API_KEY=

# Comma-separated list of origins allowed to call this API (deployed frontend + localhost).
CORS_ORIGINS=http://localhost:3000
