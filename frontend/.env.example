# Copy to .env.local. Values prefixed NEXT_PUBLIC_ are exposed to the browser.

# Booking API (backend/). Local default is http://localhost:4000.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Paystack *public* key (pk_test_… in development). The secret key belongs in
# backend/.env only — it must never reach the browser.
NEXT_PUBLIC_PAYSTACK_KEY=
