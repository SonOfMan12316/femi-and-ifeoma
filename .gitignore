# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Root-level, applies to both frontend/ and backend/ (plain two-folder monorepo — DEC-014).

# dependencies
**/node_modules

# root-level lockfile (causes Next.js workspace root confusion on Vercel)
/package-lock.json
**/.pnp
**/.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
**/coverage

# next.js (frontend)
frontend/.next/
frontend/out/

# nest (backend build output)
backend/dist/

# production
**/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets — DATABASE_URL, PAYSTACK_SECRET_KEY, etc. live here)
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# vercel
.vercel

# typescript
**/*.tsbuildinfo
frontend/next-env.d.ts

# prisma (backend)
backend/prisma/migrations/.gitkeep
